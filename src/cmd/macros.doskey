..=cd ..
...=cd ..\..
....=cd ..\..\..
clear=cls
h=doskey /history
which=where $*
cat=type $*
mkcd=mkdir "$1" $T cd /d "$1"
gs=git status -sb $*
gst=git status $*
ga=git add $*
gaa=git add --all
gd=git diff $*
gds=git diff --staged $*
gc=git commit -m $*
glog=git log --oneline --graph --decorate -n 20 $*
gbr=git branch -vv $*
gp=git push $*
gl=git pull $*
ls=dir /b $*
